rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidListing(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 2000 &&
             data.type is string && (data.type == 'teach' || data.type == 'learn') &&
             data.category is string && data.category.size() <= 60 &&
             data.tradeType is string && (data.tradeType == 'coins' || data.tradeType == 'barter' || data.tradeType == 'both') &&
             data.authorId is string && data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 100;
    }

    // Listings Collection: Public read, authenticated create/update/delete by author
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(listingId) && isValidListing(incoming());
      allow update: if isSignedIn() && isValidId(listingId) &&
                       existing().authorId == request.auth.uid &&
                       incoming().authorId == request.auth.uid &&
                       isValidListing(incoming());
      allow delete: if isSignedIn() && isValidId(listingId) && existing().authorId == request.auth.uid;
    }

    // Users Collection: Public read, owner create and update
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }

    // Connection check document
    match /test/connection {
      allow read: if true;
    }
  }
}
